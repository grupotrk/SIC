# ============================================================
# Trikode SIC - variables de entorno
# Copiá este archivo como .env.local para desarrollo.
# Nunca publiques .env ni .env.local.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Compatibilidad con scripts antiguos que leen SUPABASE_URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Admin del panel interno
ADMIN_USERNAME=admin
# Generar con: npm run admin:hash
ADMIN_PASSWORD_HASH=tu-hash-bcrypt
# Firma las cookies de rol. Usar un secreto aleatorio largo.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=tu-secreto-de-64-caracteres-o-mas

# Invitaciones / referrals
OWNER_REFERRAL_CODES=
OWNER_INVITE_REDIRECT_URL=http://localhost:3000/bienvenida

# Pagos / suscripción
PAYMENT_SUCCESS_URL=http://localhost:3000/pago-exitoso
SUBSCRIPTION_DAYS=30
SUBSCRIPTION_GRACE_DAYS=37
SUBSCRIPTION_DOWNLOAD_DAYS=120
SUBSCRIPTION_PRICE=40000
TRIAL_DAYS=7

# Contacto y notificaciones
CONTACT_WHATSAPP=
ADMIN_NOTIFICATION_EMAIL=

# Fallbacks de onboarding
FALLBACK_EMAIL_DOMAIN=sic.local
FALLBACK_COMMERCE_NAME=Comercio
FALLBACK_COMMERCE_ADDRESS=A definir

# Seeds / auditoría (solo desarrollo)
SEED_ADMIN_EMAIL=test@trikode.com.ar
SEED_ADMIN_PASS=
SEED_AUDIT_PASS=
SEED_JUANFERRERO_PASS=

# Next.js define NODE_ENV automáticamente al ejecutar dev/build/start.
# No hace falta declararlo manualmente en .env.local.
